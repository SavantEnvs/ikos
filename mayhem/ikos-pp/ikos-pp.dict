# ikos-pp.dict — libFuzzer dictionary of LLVM IR *text* tokens for the Mayhem target `ikos-pp`.
#
# Wired the fleet way: mayhem/Mayhemfile_ikos-pp carries `dictionary: /mayhem/mayhem/ikos-pp/ikos-pp.dict`
# (an absolute path is correct there — it READS baked-in image data). Proven the only way that
# actually proves anything: `/mayhem/ikos-pp -dict=mayhem/ikos-pp/ikos-pp.dict -runs=1` prints
# "Dictionary: N entries" with no ParseDictionaryFile error.
#
# Single-line tokens only. libFuzzer's dictionary grammar accepts just the \\ \" and \xHH escapes, so
# every entry below is plain printable ASCII inside double quotes.


# ---- module structure -------------------------------------------------------------------
"target datalayout = "
"target triple = "
"x86_64-unknown-linux-gnu"
"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
"source_filename = "
"define "
"declare "
"define dso_local "
"declare dso_local "
"define internal "
"define private "
"global "
"attributes #0 = "
"unnamed_addr"
"local_unnamed_addr"
"dso_local"
"dso_preemptable"
"section"
"comdat"
"align 8"
"align 16"
"align 1"
"to label"
"unwind label"

# ---- types ------------------------------------------------------------------------------
"void"
"i1"
"i8"
"i16"
"i32"
"i64"
"i128"
"half"
"float"
"double"
"x86_fp80"
"fp128"
"ppc_fp128"
"label"
"metadata"
"token"
"opaque"
"type {"
"[0 x i8]"
"[4 x i32]"
"{ i32, i8* }"
"<4 x i32>"
"<vscale x 4 x i32>"
"i8*"
"i32*"
"i8**"
"x86_mmx"
"..."

